rm(list = ls())

library(DESeq2)
library(RColorBrewer)
library(pheatmap)
library(openxlsx)

work_dir <- "~/diss"
setwd(work_dir)

annotationfile <- "genome/mart_export_human_ensembl116_gene_annotation.txt"
output_dir <- "Deseq2_output"
dir.create(output_dir, showWarnings = FALSE)

# -------------------------
# Read count data and metadata
# -------------------------

data <- readRDS("star_output/diss.RDS")

colnames(data) <- sub("ReadsPerGene.out.tab", "", colnames(data))

meta <- read.table(
  "metadata/SraRunTable.csv",
  header = TRUE,
  sep = ",",
  stringsAsFactors = FALSE
)

meta <- subset(meta, Run %in% colnames(data))
meta <- meta[, c("Run", "disease")]
meta <- meta[!duplicated(meta), ]

rownames(meta) <- meta$Run

rownames(data) <- data$GeneID
data <- data[, meta$Run]

if (!all(colnames(data) == rownames(meta))) {
  stop("Column names of count data do not match metadata row names.")
}

# -------------------------
# Clean disease labels
# -------------------------

meta$disease <- trimws(meta$disease)
meta$disease <- tolower(meta$disease)
meta$disease <- gsub("[^a-z ]", "", meta$disease)
meta$disease <- gsub(" +", " ", meta$disease)

meta$disease[meta$disease == "normal"] <- "normal"
meta$disease[grepl("deep", meta$disease)] <- "DIE"
meta$disease[grepl("ovarian", meta$disease)] <- "OE"
meta$disease[grepl("peritoneal", meta$disease)] <- "PE"
meta$disease[meta$disease == "endometriosis"] <- "endometriosis"

meta$disease <- factor(meta$disease)
meta$disease <- relevel(meta$disease, ref = "normal")

# -------------------------
# DESeq2 analysis
# -------------------------

dds <- DESeqDataSetFromMatrix(
  countData = data,
  colData = meta,
  design = ~ disease
)

dds <- DESeq(dds)

# Used for the clustered GWAS/RNA-seq overlap heatmap
vsd <- vst(dds, blind = TRUE)
vst_counts <- assay(vsd)

raw_counts <- counts(dds, normalized = FALSE)
norm_counts <- counts(dds, normalized = TRUE)

print(resultsNames(dds))

# -------------------------
# Individual subtype outputs
# -------------------------

process_result <- function(res, comparison_name, raw_counts, norm_counts, meta) {
  
  res <- as.data.frame(res)
  res$gene_id <- rownames(res)
  
  res$SignedFoldChange <- 2^abs(res$log2FoldChange) *
    sign(res$log2FoldChange)
  
  annotation <- read.delim(annotationfile, stringsAsFactors = FALSE)
  
  res <- merge(
    annotation,
    res,
    by.x = "Gene.stable.ID",
    by.y = "gene_id",
    all.y = TRUE
  )
  
  raw_countsdf <- as.data.frame(raw_counts)
  raw_countsdf$gene_id <- rownames(raw_countsdf)
  
  norm_counts_labeled <- norm_counts
  colnames(norm_counts_labeled) <- paste0(
    colnames(norm_counts_labeled),
    "_norm_count"
  )
  
  norm_countsdf <- as.data.frame(norm_counts_labeled)
  norm_countsdf$gene_id <- rownames(norm_countsdf)
  
  res <- merge(res, norm_countsdf,
               by.x = "Gene.stable.ID", by.y = "gene_id")
  res <- merge(res, raw_countsdf,
               by.x = "Gene.stable.ID", by.y = "gene_id")
  
  write.xlsx(
    res,
    file = paste0(output_dir, "/", comparison_name, "_Deseq2.xlsx"),
    overwrite = TRUE
  )
  
  siggenes <- subset(res, !is.na(padj) & padj < 0.05)
  
  write.xlsx(
    siggenes,
    file = paste0(output_dir, "/", comparison_name, "_siggenes.xlsx"),
    overwrite = TRUE
  )
  
  write.xlsx(
    subset(siggenes, log2FoldChange > 0),
    file = paste0(output_dir, "/", comparison_name, "_upsiggenes.xlsx"),
    overwrite = TRUE
  )
  
  write.xlsx(
    subset(siggenes, log2FoldChange < 0),
    file = paste0(output_dir, "/", comparison_name, "_downsiggenes.xlsx"),
    overwrite = TRUE
  )
  
  # Individual top-25 heatmap
  siggenes <- siggenes[order(siggenes$padj), ]
  n_top <- min(25, nrow(siggenes))
  
  if (n_top == 0) {
    warning(paste("No significant genes for", comparison_name))
    return(invisible(NULL))
  }
  
  top25 <- siggenes[seq_len(n_top), ]
  
  gene_labels <- top25$Gene.name
  gene_labels[is.na(gene_labels) | gene_labels == ""] <-
    top25$Gene.stable.ID[is.na(gene_labels) | gene_labels == ""]
  rownames(top25) <- make.unique(gene_labels)
  
  idx <- grep("norm_count", colnames(top25))
  top25_norm_counts <- top25[, idx]
  colnames(top25_norm_counts) <- sub(
    "_norm_count",
    "",
    colnames(top25_norm_counts)
  )
  
  anno <- data.frame(Disease = meta$disease)
  rownames(anno) <- rownames(meta)
  
  n_samples <- ncol(top25_norm_counts)
  n_genes <- nrow(top25_norm_counts)
  cell_pt <- 12
  
  fig_width_in <- (n_samples * cell_pt / 72.27) + 4
  fig_height_in <- (n_genes * cell_pt / 72.27) + 3
  
  pheatmap(
    as.matrix(top25_norm_counts),
    cellwidth = cell_pt,
    cellheight = cell_pt,
    scale = "row",
    annotation_col = anno,
    main = comparison_name,
    filename = paste0(
      output_dir,
      "/",
      comparison_name,
      "_top25_heatmap.png"
    ),
    width = fig_width_in,
    height = fig_height_in,
    res = 300
  )
}

res_die <- results(dds, contrast = c("disease", "DIE", "normal"))
res_oe <- results(dds, contrast = c("disease", "OE", "normal"))
res_pe <- results(dds, contrast = c("disease", "PE", "normal"))

process_result(res_die, "DIE_vs_normal", raw_counts, norm_counts, meta)
process_result(res_oe, "OE_vs_normal", raw_counts, norm_counts, meta)
process_result(res_pe, "PE_vs_normal", raw_counts, norm_counts, meta)

# -------------------------
# GWAS / RNA-seq overlap heatmap
# -------------------------

gwas_genes <- c(
  "WNT4", "CDC42", "LINC00339", "CDC42-IT1", "SYNE1", "FSHB",
  "RP1-224A6.3", "ARL14EP", "GREB1", "CCDC170", "RP4-710M3.1",
  "C6orf211", "RP4-562D20.2", "RN7SL674P", "RP11-408N14.1",
  "CDKN2B-AS1", "KDR", "GDAP1", "RNA5SP84", "CTD-2320G14.2",
  "RP1-167F1.2", "ESR1", "RP4-625H18.2", "HMGN1P19", "IL1A",
  "RMND1", "IL1B", "RNLS", "RP3-471C18.2", "BMF",
  "CTD-2227E11.1", "AC003090.1", "DNM3", "VEZT", "SRP14-AS1",
  "RP11-521C20.2", "FGD6", "MLLT10", "ZBTB2", "RPS2P32",
  "TRA2A", "SLC9A9", "RP3-471C18.1", "MTG1", "MIR3685",
  "MIR331", "LINC00629", "AC079780.3", "RP11-456D7.1", "IGF1",
  "HOXC-AS2", "DNM3OS", "MIR196A2", "SKAP1", "RIN3",
  "IGF2BP3", "PLAC1"
)

# Combine subtype DESeq2 results
all_results <- rbind(
  transform(as.data.frame(res_die), gene_id = rownames(res_die)),
  transform(as.data.frame(res_oe), gene_id = rownames(res_oe)),
  transform(as.data.frame(res_pe), gene_id = rownames(res_pe))
)

# Attach gene symbols to RNA-seq Ensembl IDs
annotation <- read.delim(annotationfile, stringsAsFactors = FALSE)

all_results$GeneSymbol <- annotation$Gene.name[
  match(all_results$gene_id, annotation$Gene.stable.ID)
]

# Significant genes appearing in both the RNA-seq and GWAS lists
overlap_results <- subset(
  all_results,
  !is.na(padj) &
    padj < 0.05 &
    toupper(trimws(GeneSymbol)) %in% toupper(gwas_genes)
)

# One entry per overlapping gene, ranked by adjusted p-value
overlap_results <- overlap_results[order(overlap_results$padj), ]
top_ids <- unique(overlap_results$gene_id)

message(
  "Significant GWAS/RNA-seq overlap genes plotted: ",
  length(top_ids)
)

if (length(top_ids) == 0) {
  
  warning(
    "No significant GWAS/RNA-seq overlap genes found; no overlap heatmap created."
  )
  
} else {
  
  # Keep only the four groups shown in the heatmap
  groups_to_include <- c("normal", "OE", "DIE", "PE")
  
  samples_to_include <- rownames(meta)[
    meta$disease %in% groups_to_include
  ]
  
  # VST expression is used for clearer clustering
  combined_counts <- vst_counts[top_ids, samples_to_include]
  
  # Use gene symbols as row labels
  gene_symbols <- annotation$Gene.name[
    match(rownames(combined_counts), annotation$Gene.stable.ID)
  ]
  
  missing_symbol <- is.na(gene_symbols) | gene_symbols == ""
  gene_symbols[missing_symbol] <- rownames(combined_counts)[missing_symbol]
  
  rownames(combined_counts) <- make.unique(gene_symbols)
  
  # Subtype annotation bar
  anno <- data.frame(
    Subtype = droplevels(meta[samples_to_include, "disease"])
  )
  rownames(anno) <- samples_to_include
  
  annotation_colors <- list(
    Subtype = c(
      normal = "grey60",
      OE = "#00BFC4",
      DIE = "#7CAE00",
      PE = "#F8766D"
    )
  )
  
  # Scale each gene across samples and limit visual outliers
  heatmap_matrix <- t(scale(t(combined_counts)))
  heatmap_matrix[heatmap_matrix > 3] <- 3
  heatmap_matrix[heatmap_matrix < -3] <- -3
  
  n_samples <- ncol(heatmap_matrix)
  n_genes <- nrow(heatmap_matrix)
  cell_pt <- 10
  
  fig_width_in <- (n_samples * cell_pt / 72.27) + 4
  fig_height_in <- (n_genes * cell_pt / 72.27) + 3

  # Arrange samples into subtype blocks for direct comparison
  groups_to_include <- c("normal", "OE", "DIE", "PE")
  
  meta_plot <- meta[samples_to_include, , drop = FALSE]
  meta_plot$Subtype <- factor(meta_plot$disease, levels = groups_to_include)
  meta_plot <- meta_plot[order(meta_plot$Subtype), , drop = FALSE]
  
  ordered_samples <- rownames(meta_plot)
  
  heatmap_matrix <- heatmap_matrix[, ordered_samples, drop = FALSE]
  
  anno <- data.frame(Subtype = meta_plot$Subtype)
  rownames(anno) <- ordered_samples
  
  group_sizes <- table(meta_plot$Subtype)
  gaps <- cumsum(as.integer(group_sizes))
  gaps <- gaps[-length(gaps)]
    
  pheatmap(
    heatmap_matrix,
    scale = "none",
    annotation_col = anno,
    annotation_colors = annotation_colors,
    cluster_rows = TRUE,
    cluster_cols = FALSE,
    gaps_col = gaps,
    show_colnames = FALSE,
    border_color = NA,
    main = "Significant GWAS/RNA-seq overlap genes by subtype",
    filename = paste0(output_dir, "/GWAS_RNAseq_overlap_by_subtype.png"),
    width = fig_width_in,
    height = fig_height_in,
    res = 300
  )
  
}

