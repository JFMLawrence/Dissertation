rm(list = ls())

library(DESeq2)
library(RColorBrewer)
library(pheatmap)
library(openxlsx)

work_dir <- "~/diss"
setwd(work_dir)

annotationfile <- "genome/mart_export_human_ensembl116_gene_annotation.txt"
output_dir <- "Deseq2_output"
dir.create(output_dir, showWarnings = FALSE)


## Read count data and metadata

data <- readRDS("star_output/diss.RDS")

colnames(data) <- sub("ReadsPerGene.out.tab", "", colnames(data))

meta <- read.table(
  "metadata/SraRunTable.csv",
  header = TRUE,
  sep = ",",
  stringsAsFactors = FALSE
)

meta <- subset(meta, Run %in% colnames(data))
meta <- meta[, c("Run", "disease")]
meta <- meta[!duplicated(meta), ]

rownames(meta) <- meta$Run

rownames(data) <- data$GeneID
data <- data[, meta$Run]

if (!all(colnames(data) == rownames(meta))) {
  stop("Column names of count data do not match metadata row names.")
}


## Clean disease labels
meta$disease <- trimws(meta$disease)
meta$disease <- tolower(meta$disease)
meta$disease <- gsub("[^a-z ]", "", meta$disease)
meta$disease <- gsub(" +", " ", meta$disease)

meta$disease[meta$disease == "normal"] <- "normal"
meta$disease[grepl("deep", meta$disease)] <- "DIE"
meta$disease[grepl("ovarian", meta$disease)] <- "OE"
meta$disease[grepl("peritoneal", meta$disease)] <- "PE"
meta$disease[meta$disease == "endometriosis"] <- "endometriosis"

meta$disease <- factor(meta$disease)
meta$disease <- relevel(meta$disease, ref = "normal")


## DESeq2 analysis
dds <- DESeqDataSetFromMatrix(
  countData = data,
  colData = meta,
  design = ~ disease
)

dds <- DESeq(dds)

vsd <- vst(dds, blind = TRUE)
vst_counts <- assay(vsd)

raw_counts <- counts(dds, normalized = FALSE)
norm_counts <- counts(dds, normalized = TRUE)

print(resultsNames(dds))


# Individual subtype outputs
process_result <- function(res, comparison_name, raw_counts, norm_counts, meta) {
  
  res <- as.data.frame(res)
  res$gene_id <- rownames(res)
  
  res$SignedFoldChange <- 2^abs(res$log2FoldChange) *
    sign(res$log2FoldChange)
  
  annotation <- read.delim(annotationfile, stringsAsFactors = FALSE)
  
  res <- merge(
    annotation,
    res,
    by.x = "Gene.stable.ID",
    by.y = "gene_id",
    all.y = TRUE
  )
  
  raw_countsdf <- as.data.frame(raw_counts)
  raw_countsdf$gene_id <- rownames(raw_countsdf)
  
  norm_counts_labeled <- norm_counts
  colnames(norm_counts_labeled) <- paste0(
    colnames(norm_counts_labeled),
    "_norm_count"
  )
  
  norm_countsdf <- as.data.frame(norm_counts_labeled)
  norm_countsdf$gene_id <- rownames(norm_countsdf)
  
  res <- merge(res, norm_countsdf,
               by.x = "Gene.stable.ID", by.y = "gene_id")
  res <- merge(res, raw_countsdf,
               by.x = "Gene.stable.ID", by.y = "gene_id")
  
  write.xlsx(
    res,
    file = paste0(output_dir, "/", comparison_name, "_Deseq2.xlsx"),
    overwrite = TRUE
  )
  
  siggenes <- subset(res, !is.na(padj) & padj < 0.05)
  
  write.xlsx(
    siggenes,
    file = paste0(output_dir, "/", comparison_name, "_siggenes.xlsx"),
    overwrite = TRUE
  )
  
  write.xlsx(
    subset(siggenes, log2FoldChange > 0),
    file = paste0(output_dir, "/", comparison_name, "_upsiggenes.xlsx"),
    overwrite = TRUE
  )
  
  write.xlsx(
    subset(siggenes, log2FoldChange < 0),
    file = paste0(output_dir, "/", comparison_name, "_downsiggenes.xlsx"),
    overwrite = TRUE
  )
  
  # Individual top-25 heatmap
  siggenes <- siggenes[order(siggenes$padj), ]
  n_top <- min(25, nrow(siggenes))
  
  if (n_top == 0) {
    warning(paste("No significant genes for", comparison_name))
    return(invisible(NULL))
  }
  
  top25 <- siggenes[seq_len(n_top), ]
  
  gene_labels <- top25$Gene.name
  gene_labels[is.na(gene_labels) | gene_labels == ""] <-
    top25$Gene.stable.ID[is.na(gene_labels) | gene_labels == ""]
  rownames(top25) <- make.unique(gene_labels)
  
  idx <- grep("norm_count", colnames(top25))
  top25_norm_counts <- top25[, idx]
  colnames(top25_norm_counts) <- sub(
    "_norm_count",
    "",
    colnames(top25_norm_counts)
  )
  
  anno <- data.frame(Disease = meta$disease)
  rownames(anno) <- rownames(meta)
  
  n_samples <- ncol(top25_norm_counts)
  n_genes <- nrow(top25_norm_counts)
  cell_pt <- 12
  
  fig_width_in <- (n_samples * cell_pt / 72.27) + 4
  fig_height_in <- (n_genes * cell_pt / 72.27) + 3
  
  pheatmap(
    as.matrix(top25_norm_counts),
    cellwidth = cell_pt,
    cellheight = cell_pt,
    scale = "row",
    annotation_col = anno,
    main = comparison_name,
    filename = paste0(
      output_dir,
      "/",
      comparison_name,
      "_top25_heatmap.png"
    ),
    width = fig_width_in,
    height = fig_height_in,
    res = 300
  )
}

res_die <- results(dds, contrast = c("disease", "DIE", "normal"))
res_oe <- results(dds, contrast = c("disease", "OE", "normal"))
res_pe <- results(dds, contrast = c("disease", "PE", "normal"))

process_result(res_die, "DIE_vs_normal", raw_counts, norm_counts, meta)
process_result(res_oe, "OE_vs_normal", raw_counts, norm_counts, meta)
process_result(res_pe, "PE_vs_normal", raw_counts, norm_counts, meta)


