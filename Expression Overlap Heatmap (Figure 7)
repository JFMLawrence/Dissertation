  sample = c("ERR14943004","ERR14943005","ERR14943006","ERR14943007","ERR14943008","ERR14943009","ERR14943010","ERR14943011",
             "ERR14943012","ERR14943013","ERR14943014","ERR14943015","ERR14943016","ERR14943017","ERR14943018","ERR14943019",
             "ERR14943020","ERR14943021","ERR14943022","ERR14943023","ERR14943024","ERR14943025","ERR14943026","ERR14943027",
             "ERR14943028","ERR14943030","ERR14943031","ERR14943032","ERR14943033","ERR14943034","ERR14943035","ERR14943036",
             "ERR14943038","ERR14943039","ERR14943040","ERR14943041","ERR14943043","ERR14943044","ERR14943045","ERR14943046",
             "ERR14943047","ERR14943048","ERR14943049","ERR14943050","ERR14943051","ERR14943056","ERR14943057","ERR14943059"),
  group  = c("Normal","Normal","Normal","Normal","Normal","Normal","Normal","Normal","Normal","Normal","Normal","Normal",
             "Normal","Normal","Normal","DIE","DIE","DIE","DIE","DIE","DIE","DIE","DIE","DIE","DIE","DIE","DIE","DIE","DIE",
             "DIE","DIE","OE","OE","OE","OE","OE","OE","OE","OE","OE","OE","OE","PE","PE","PE","PE","PE","PE")
)

## Sample-expression alignment  
norm_long <- DIE_vs_normal_Deseq2 %>%
  as.data.frame() %>%
  dplyr::select(Gene.stable.ID, Gene.name, ends_with("_norm_count")) %>%
  tidyr::pivot_longer(cols = ends_with("_norm_count"),
                      names_to = "sample",
                      values_to = "norm_count") %>%
  dplyr::mutate(sample = gsub("_norm_count", "", sample)) %>%
  dplyr::left_join(sample_meta, by = "sample")

## Check for unmatched samples
unmatched <- norm_long %>% dplyr::filter(is.na(group)) %>% dplyr::distinct(sample)
if (nrow(unmatched) > 0) {
  warning("These samples did not match sample_meta: ", paste(unmatched$sample, collapse = ", "))
}

## Average normalized count per gene per group 
group_means_gwas <- norm_long %>%
  dplyr::filter(!is.na(group)) %>%
  dplyr::group_by(Gene.stable.ID, Gene.name, group) %>%
  dplyr::summarise(mean_norm_count = mean(norm_count, na.rm = TRUE), .groups = "drop") %>%
  dplyr::filter(Gene.stable.ID %in% annot_gwas_df$gene_id) %>%
  dplyr::mutate(gene_label = dplyr::if_else(is.na(Gene.name) | Gene.name == "",
                                            Gene.stable.ID, Gene.name))

## Pivot wide: rows = genes, columns = groups (DIE, Normal, OE, PE) 
wide_expr <- group_means_gwas %>%
  dplyr::select(gene_label, group, mean_norm_count) %>%
  tidyr::pivot_wider(names_from = group, values_from = mean_norm_count)

mat_expr <- as.matrix(wide_expr[, -1])
rownames(mat_expr) <- wide_expr$gene_label
mode(mat_expr) <- "numeric"

## Drop zero-variance genes-
row_sd <- apply(mat_expr, 1, sd)
sum(row_sd == 0)
mat_expr_filtered <- mat_expr[row_sd > 0, , drop = FALSE]

## Heatmap 
mat_expr_filtered <- mat_expr[row_sd > 0, , drop = FALSE]

output_plot_file <- "heatmap_final.png"

pheatmap(
  mat_expr_filtered,
  cluster_rows = TRUE,
  cluster_cols = TRUE,
  scale = "row",
  fontsize = 10,
  fontsize_row = 8,
  fontsize_col = 10,
  filename = output_plot_file,
  width = 8,
  height = 10
)
