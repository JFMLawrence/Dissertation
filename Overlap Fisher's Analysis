## Remove Y_RNA rows from the RNA-seq results universe 
all_results_clean <- subset(all_results, GeneSymbol != "Y_RNA" | is.na(GeneSymbol))

## Fisher's exact test function, per comparison + direction 
run_fisher <- function(data, comparison_name, direction, gwas_list, padj_cutoff = 0.05) {
  
  df <- subset(data, Comparison == comparison_name & !is.na(padj) & !is.na(log2FoldChange))
  
  df$in_gwas <- toupper(trimws(df$GeneSymbol)) %in% toupper(gwas_list)
  
  if (direction == "UP") {
    df$is_de <- df$padj < padj_cutoff & df$log2FoldChange > 0
  } else if (direction == "DOWN") {
    df$is_de <- df$padj < padj_cutoff & df$log2FoldChange < 0
  } else { # "ANY"
    df$is_de <- df$padj < padj_cutoff
  }
  
  # Build 2x2 table
  a <- sum(df$in_gwas & df$is_de)        # GWAS gene & DE
  b <- sum(df$in_gwas & !df$is_de)       # GWAS gene & not DE
  c <- sum(!df$in_gwas & df$is_de)       # not GWAS & DE
  d <- sum(!df$in_gwas & !df$is_de)      # not GWAS & not DE
  
  mat <- matrix(c(a, b, c, d), nrow = 2, byrow = TRUE,
                dimnames = list(c("GWAS_gene", "not_GWAS"), c("DE", "not_DE")))
  
  ft <- fisher.test(mat)
  
  gene_list <- df$GeneSymbol[df$in_gwas & df$is_de]
  
  data.frame(
    Comparison = comparison_name,
    Direction = direction,
    Gene_count = a,
    Overlap_pct = round(100 * a / length(gwas_list), 1),  # % of the 57 candidate loci
    Fisher_p = ft$p.value,
    Odds_ratio = unname(ft$estimate),
    Gene_list = paste(sort(gene_list), collapse = ", "),
    stringsAsFactors = FALSE
  )
}

## Run across all comparisons and directions 
comparisons <- c("DIE_vs_normal", "OE_vs_normal", "PE_vs_normal")
directions  <- c("UP", "DOWN")

fisher_results <- do.call(rbind, lapply(comparisons, function(comp) {
  do.call(rbind, lapply(directions, function(dir) {
    run_fisher(all_results_clean, comp, dir, gwas_genes_clean)
  }))
}))

print(fisher_results)

